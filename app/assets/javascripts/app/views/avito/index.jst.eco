<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('Avito') %> <small><%- @T('Accounts') %></small></h1>
  </div>

  <div class="page-header-meta">
    <a class="btn btn--success js-new"><%- @T('Add Account') %></a>
  </div>
</div>

<div class="page-content">

<% if _.isEmpty(@items): %>
  <div class="page-description">
    <p><%- @T('You have no configured %s right now.', 'Avito Account') %></p>
    <p><%- @T('Each Avito account needs the Messenger API subscription and its own client ID and secret from the account\'s API settings.') %></p>
  </div>
<% else: %>

<% for item in @items: %>
  <% channel = item.channel %>
  <% options = channel.options %>
  <% webhook = options.webhook || {} %>
  <div class="action <% if channel.active isnt true: %>is-inactive<% end %>" data-id="<%= channel.id %>">
    <div class="action-block action-row">
      <h2>
        <% if channel.status_in is 'error' || webhook.error: %>
          <%- @Icon('status', 'error inline') %>
        <% else: %>
          <%- @Icon('status', 'supergood-color inline') %>
        <% end %>
        <%= options.name %> <span class="text-muted">#<%= options.user_id %></span>
      </h2>
    </div>
    <div class="action-flow action-flow--row">
      <div class="action-block">
        <h3><%- @T('Chats') %></h3>
        <%= options.name %>
      </div>
      <%- @Icon('arrow-right', 'action-flow-icon') %>
      <div class="action-block">
        <h3><%- @T('Group') %></h3>
        <%= item.groupName %>
      </div>
    </div>
    <div class="action-block action-block--flex">
      <h3><%- @T('Webhook') %></h3>
      <% if webhook.error: %>
        <div class="alert alert--danger" role="alert"><%= webhook.error %></div>
      <% else if webhook.subscribed_at: %>
        <p><%- @T('Subscribed') %> <%- @humanTime(webhook.subscribed_at) %></p>
      <% else: %>
        <p class="text-muted"><%- @T('Not subscribed') %></p>
      <% end %>
      <p class="text-muted"><code><%= item.webhookUrl %></code></p>
      <% if channel.preferences && channel.preferences.avito_webhook_at: %>
        <p><%- @T('Last delivery') %> <%- @humanTime(channel.preferences.avito_webhook_at) %></p>
      <% else: %>
        <p class="text-muted"><%- @T('No delivery received yet') %></p>
      <% end %>
    </div>
    <div class="action-block action-block--flex">
      <h3><%- @T('Polling') %></h3>
      <% if channel.status_in is 'error': %>
        <div class="alert alert--danger" role="alert"><%= channel.last_log_in %></div>
      <% else if channel.preferences && channel.preferences.last_fetch: %>
        <p><%- @humanTime(channel.preferences.last_fetch) %>: <%= channel.last_log_in %></p>
      <% else: %>
        <p class="text-muted"><%- @T('Not polled yet') %></p>
      <% end %>
    </div>
    <div class="action-block action-block--flex">
      <h3><%- @T('History') %></h3>
      <div class="js-historyStatus"><%- App.view('avito/history_status')(history: item.history) %></div>
      <p class="text-muted"><%- @T('Avito gives out only the latest ~1100 chats of an account, and the latest ~1100 messages of each chat: anything older cannot be loaded.') %></p>
    </div>
    <div class="action-block action-block--flex js-checkResult hide"></div>
    <div class="action-controls">
      <div class="btn btn--danger btn--secondary js-delete"><%- @T('Delete') %></div>
      <% if channel.active is true: %>
        <div class="btn btn--secondary js-disable"><%- @T('Disable') %></div>
      <% else: %>
        <div class="btn btn--secondary js-enable"><%- @T('Enable') %></div>
      <% end %>
      <div class="btn btn--secondary js-subscribe"><%- @T('Subscribe webhook again') %></div>
      <div class="btn btn--secondary js-check"><%- @T('Check connection') %></div>
      <% if channel.active is true: %>
        <div class="btn btn--secondary js-sync"><%- @T('Sync now') %></div>
        <div class="btn btn--secondary js-history"><%- @T('Load history') %></div>
      <% end %>
      <div class="btn js-edit"><%- @T('Edit') %></div>
    </div>
  </div>
<% end %>
<% end %>
</div>
